# Configuração para hospedagem Apache (HostGator)

# Tipos MIME corretos para PWA
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg

# O service worker nunca deve ficar preso em cache antigo,
# senão os visitantes não recebem atualizações do app
<IfModule mod_headers.c>
  <FilesMatch "sw\.js$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|svg|json|webmanifest)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# Compressão (deixa o app mais leve no 4G do zoo)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/manifest+json
</IfModule>
